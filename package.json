{
  "name": "stackfolio",
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "files": [
    "/dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "browser": "./dist/browser/index.js",
      "node": "./dist/node/index.mjs"
    },
    "./reactor": {
      "types": "./dist/types/reactor/index.d.ts",
      "browser": "./dist/browser/reactor/index.js"
    },
    "./document-models": {
      "types": "./dist/types/document-models/index.d.ts",
      "browser": "./dist/browser/document-models/index.js",
      "node": "./dist/node/document-models/index.mjs"
    },
    "./document-models/*": {
      "types": "./dist/types/document-models/*/index.d.ts",
      "browser": "./dist/browser/document-models/*/index.js",
      "node": "./dist/node/document-models/*/index.mjs"
    },
    "./editors": {
      "types": "./dist/types/editors/index.d.ts",
      "browser": "./dist/browser/editors/index.js",
      "node": "./dist/node/editors/index.mjs"
    },
    "./editors/*": {
      "types": "./dist/types/editors/*/editor.d.ts",
      "browser": "./dist/browser/editors/*/editor.js",
      "node": "./dist/node/editors/*/editor.mjs"
    },
    "./subgraphs": {
      "types": "./dist/types/subgraphs/index.d.ts",
      "node": "./dist/node/subgraphs/index.mjs"
    },
    "./scalars": {
      "types": "./dist/types/scalars/index.d.ts",
      "browser": "./dist/browser/scalars/index.js",
      "node": "./dist/node/scalars/index.mjs"
    },
    "./connect-routes": {
      "browser": "./dist/browser/connect-routes.js"
    },
    "./processors": {
      "types": "./dist/types/processors/index.d.ts",
      "browser": "./dist/browser/processors/index.js",
      "node": "./dist/node/processors/index.mjs"
    },
    "./pieces": {
      "types": "./dist/types/pieces/index.d.ts",
      "node": "./dist/node/pieces/index.mjs"
    },
    "./pieces/*": {
      "types": "./dist/types/pieces/*/index.d.ts",
      "node": "./dist/node/pieces/*/index.mjs"
    },
    "./manifest": "./dist/powerhouse.manifest.json",
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "lint": "ph-cli generate connect-routes && oxlint --type-aware --type-check",
    "lint:fix": "ph-cli generate connect-routes && oxlint --type-aware --type-check --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "tsc": "ph-cli generate connect-routes && tsc && tsc -p hosts",
    "tsc:watch": "tsc --watch",
    "check-circular-imports": "npx dpdm -T ./index.ts",
    "generate": "ph-cli generate",
    "connect": "ph-cli connect",
    "build": "ph-cli build",
    "reactor": "ph-cli reactor",
    "service": "ph-cli service",
    "vetra": "ph-cli vetra",
    "mcp": "ph-cli mcp",
    "service-startup": "bash ./node_modules/@powerhousedao/ph-cli/dist/scripts/service-startup.sh",
    "service-unstartup": "bash ./node_modules/@powerhousedao/ph-cli/dist/scripts/service-unstartup.sh"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.15",
    "@electric-sql/pglite-tools": "0.2.20",
    "@powerhousedao/clint": "6.2.3-dev.96",
    "@powerhousedao/connect": "6.2.3-dev.96",
    "@powerhousedao/connect-core": "6.2.3-dev.96",
    "@powerhousedao/design-system": "6.2.3-dev.96",
    "@powerhousedao/desktop": "6.2.3-dev.96",
    "@powerhousedao/document-engineering": "1.40.5",
    "@powerhousedao/host-core": "6.2.3-dev.96",
    "@powerhousedao/ph-cli": "6.2.3-dev.96",
    "@powerhousedao/reactor": "6.2.3-dev.96",
    "@powerhousedao/reactor-browser": "6.2.3-dev.96",
    "@powerhousedao/shared": "6.2.3-dev.96",
    "@powerhousedao/switchboard": "6.2.3-dev.96",
    "@powerhousedao/vetra-studio": "6.2.3-dev.96",
    "@solana-program/system": "0.10.0",
    "@solana-program/token": "0.9.0",
    "@solana/kit": "5.5.1",
    "@tailwindcss/cli": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "1.170.41",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "5.0.3",
    "date-fns": "4.3.0",
    "document-model": "6.2.3-dev.96",
    "graphql": "16.12.0",
    "graphql-tag": "2.12.6",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "rolldown": "1.0.2",
    "tailwindcss": "^4.1.16",
    "typescript": "~7.0.2",
    "vite": "8.0.14",
    "vitest": "5.0.3",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@powerhousedao/connect-core": "6.2.3-dev.96",
    "@powerhousedao/reactor-browser": "6.2.3-dev.96",
    "@tanstack/react-router": "^1.170.41",
    "document-model": "6.2.3-dev.96",
    "graphql": "^16",
    "graphql-tag": "^2",
    "react": "^19",
    "react-dom": "^19",
    "zod": "^4"
  },
  "resolutions": {
    "@solana-program/system": "0.10.0",
    "@solana-program/token": "0.9.0",
    "@solana/kit": "5.5.1",
    "date-fns": "4.3.0",
    "rolldown": "1.0.2",
    "vite": "8.0.14"
  },
  "overrides": {
    "@solana-program/system": "$@solana-program/system",
    "@solana-program/token": "$@solana-program/token",
    "@solana/kit": "$@solana/kit",
    "date-fns": "$date-fns",
    "rolldown": "$rolldown",
    "vite": "$vite"
  }
}
